# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox). Leave empty to run with simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Any OpenAI-compatible chat completions endpoint. Leave the key empty to run rules only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./data/payguard.db
BACKEND_URL=http://127.0.0.1:8000
DASHBOARD_URL=http://127.0.0.1:8501
